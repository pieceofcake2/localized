{
    "name": "pieceofcake2/localized",
    "description": "CakePHP 2 localized validation rules for postal codes, phone numbers and person IDs of many countries, with core translations",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "localized", "i18n", "l10n"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.1",
        "pieceofcake2/phpstan-cakephp2": "^1.0"
    },
    "replace": {
        "cakephp/localized": "^2.0"
    },
    "autoload-dev": {
        "exclude-from-classmap": [
            "vendor/pieceofcake2/app/src/Console/Command/AppShell.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Localized"
    }
}
